NEXTAUTH_SECRET=your-secret-here  # Generate with `bunx openssl rand -base64 32` or online
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional — two things use these, and both say so plainly rather than hiding
# while a value is missing: the "Open from Google Drive" button on /backup, and
# the shared pictures folder behind the picture control on /document. Both are
# public by nature (they end up in the browser bundle); the client secret above
# stays on the server.
#
# In the Google Cloud Console, for the same project as the client id above:
#   1. Enable both the "Google Drive API" and the "Google Picker API".
#   2. Add this site's origin to the OAuth client's Authorized JavaScript origins
#      (http://localhost:3000 for dev, plus the deployed origin). A phone reaches
#      the deployed origin, so leaving that one out is what makes Drive work at
#      the desk and nowhere else.
#   3. Add the .../auth/drive.file scope to the OAuth consent screen. It is the
#      narrow one — the files the visitor picks by hand, plus the ones this app
#      makes itself — and is not a scope that needs Google's app verification.
#      Nothing else in the Drive is ever visible to the site under it.
#   4. Make an API key, restrict it to this site's origins and to the Picker API.
#
# The picture folder needs only the client id: it never opens the Picker, every
# file in it being one the app made. Missing the key below therefore costs the
# backup button and nothing else.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=same-as-GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_PICKER_KEY=your-browser-api-key
