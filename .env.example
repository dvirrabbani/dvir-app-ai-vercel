NEXTAUTH_SECRET=your-secret-here  # Generate with `bunx openssl rand -base64 32` or online
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional — only the "Open from Google Drive" button on /backup uses these, and
# it sits there disabled, saying so, while either is missing. Both are public by
# nature (they end up in the browser bundle); the client secret above stays on
# the server.
#
# In the Google Cloud Console, for the same project as the client id above:
#   1. Enable both the "Google Drive API" and the "Google Picker API".
#   2. Add this site's origin to the OAuth client's Authorized JavaScript origins
#      (http://localhost:3000 for dev, plus the deployed origin).
#   3. Add the .../auth/drive.file scope to the OAuth consent screen. It is the
#      narrow one — only files the visitor picks by hand — and is not a scope
#      that needs Google's app verification.
#   4. Make an API key, restrict it to this site's origins and to the Picker API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=same-as-GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_PICKER_KEY=your-browser-api-key
